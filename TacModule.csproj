<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TAC Module: a standalone NOXMFD extension (see NOXMFD's EXTENSIONS.md). Lives in its own
    repo, separate from NOXMFD's own source — it never edits NOXMFD's plugin/web code, only
    consumes the public NOXMFD.Api surface via the prebuilt lib\NOXMFD.dll committed alongside
    this project.

    >>> SET YOUR GAME PATH <<<
    GameDir must point at your Nuclear Option install on the machine that BUILDS this. Don't edit
    the default below — create a local, gitignored GameDir.props next to this file instead:

      <Project><PropertyGroup>
        <GameDir>D:\SteamLibrary\steamapps\common\Nuclear Option</GameDir>
      </PropertyGroup></Project>
  -->
  <Import Project="GameDir.props" Condition="Exists('GameDir.props')" />

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>NOXMFD.TacModule</AssemblyName>
    <Product>NOXMFD: TAC Module Extension</Product>
    <Description>TAC mission-control target board for NOXMFD, as an extension</Description>
    <Version>0.1.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>TacModule</RootNamespace>
    <DebugType>portable</DebugType>
    <!-- CS0649: the [Serializable] command/message classes are filled by JsonUtility through
         reflection, which the compiler can't see. -->
    <NoWarn>BepInEx002;CS0649</NoWarn>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- Own embedded web assets, mirroring NOXMFD's own src/plugin + src/web split
         (docs/src-architecture.md) — resource names still end in ".web.<dotted path>" regardless
         of the src\ prefix, resolved by TacPageAssets.cs's own suffix match. -->
    <EmbeddedResource Include="src\web\**\*" Exclude="src\web\**\*.md;src\web\**\*.test.js" />
    <!-- tools/tests is its own project (TacTests.csproj) and must not compile into the plugin. -->
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.6" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only NOXMFD dependency this project has: its public Api surface. Referenced as a
         prebuilt DLL (not source) since this repo is standalone from NOXMFD's own — Private=
         false because BepInEx already loads NOXMFD.dll itself; copying a second copy alongside
         this plugin would double-load the assembly. -->
    <Reference Include="NOXMFD">
      <HintPath>lib\NOXMFD.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's own assemblies, for what NOXMFD's API doesn't cover (the local faction, unit
         lookups, the leader's target list). Compile-time only, like NOXMFD's own references: the
         game already loads them. Mirage is needed because FactionHQ and Unit derive from its types. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\NuclearOption_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirage">
      <HintPath>$(GameDir)\NuclearOption_Data\Managed\Mirage.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Reads the messages between players: JsonUtility leaves arrays of objects empty in the game's
         Mono runtime. The game ships and loads Newtonsoft.Json 13 itself. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameDir)\NuclearOption_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build">
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(GameDir)\BepInEx\plugins"
      OverwriteReadOnlyFiles="true" />
    <Message Text="Deployed $(AssemblyName).dll to $(GameDir)\BepInEx\plugins" Importance="high" />
  </Target>

</Project>
